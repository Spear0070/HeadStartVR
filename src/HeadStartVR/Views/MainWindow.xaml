<Window x:Class="HeadStartVR.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:HeadStartVR.Views"
        xmlns:vm="clr-namespace:HeadStartVR.ViewModels"
        Title="HeadStart VR" Width="1180" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        Icon="pack://application:,,,/HeadStartVR;component/Assets/headstart.ico"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <v:VisibleIf x:Key="Vis" />

        <!-- Library list item -->
        <Style x:Key="GameListItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="10" Padding="10,9" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,12" Background="{StaticResource AccentGradient}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#171B24" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D2130" />
                                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Game icon with initials fallback -->
        <DataTemplate x:Key="GameIcon" DataType="{x:Type vm:GameItem}">
            <Grid>
                <Border CornerRadius="9" Background="{StaticResource AccentGradient}">
                    <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="9" Background="#10131A" Visibility="{Binding Icon, Converter={StaticResource Vis}}">
                    <Image Source="{Binding Icon}" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Launch step row -->
        <DataTemplate x:Key="StepRow" DataType="{x:Type vm:LaunchStep}">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="30" Height="30" VerticalAlignment="Top">
                    <Ellipse x:Name="ring" Stroke="{StaticResource BorderBrush}" StrokeThickness="2" />
                    <Ellipse x:Name="spin" Stroke="{StaticResource Accent2Brush}" StrokeThickness="2.5" StrokeDashArray="9 100"
                             StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="spinRot" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock x:Name="glyph" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock x:Name="title" Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding Detail, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Pending">
                    <Setter TargetName="title" Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="spin" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ring" Property="Stroke" Value="#22303F" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="spinning">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="spinRot" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="spinning" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="WaitingForYou">
                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="glyph" Property="Text" Value="&#xE77B;" />
                    <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="ring" Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="glyph" Property="Text" Value="&#xE73E;" />
                    <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource BgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warning">
                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="glyph" Property="Text" Value="&#xE7BA;" />
                    <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="ring" Property="Fill" Value="{StaticResource DangerBrush}" />
                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource DangerBrush}" />
                    <Setter TargetName="glyph" Property="Text" Value="&#xE711;" />
                    <Setter TargetName="glyph" Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Skipped">
                    <Setter TargetName="glyph" Property="Text" Value="&#xE738;" />
                    <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter TargetName="title" Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Grid Background="{StaticResource PanelBrush}">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource AccentGradient}">
                    <Canvas Width="18" Height="10">
                        <Rectangle Width="18" Height="10" RadiusX="4" RadiusY="4" Fill="White" />
                        <Ellipse Canvas.Left="3" Canvas.Top="2.5" Width="5" Height="5" Fill="#5B4BD8" />
                        <Ellipse Canvas.Left="10" Canvas.Top="2.5" Width="5" Height="5" Fill="#1FA5C9" />
                    </Canvas>
                </Border>
                <TextBlock Text="HEADSTART" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14" Margin="11,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="VR" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14" Margin="6,0,0,0"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ChromeButton}" FontSize="14" Content="&#xE713;" ToolTip="Settings"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Settings_Click" />
                <Rectangle Width="1" Height="18" Fill="{StaticResource BorderBrush}" Margin="4,0" />
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- ============ Body ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,0">
                <Grid Margin="14,18,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,12">
                        <TextBlock Text="LIBRARY" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                        <Border CornerRadius="8" Background="#1E2330" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding LibraryCount}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </Border>
                    </StackPanel>

                    <ListBox x:Name="GameList" Grid.Row="1" ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource GameListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="{Binding ShowLaunch, Converter={x:Static v:Inverse.Instance}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Width="42" Height="42" Content="{Binding}" ContentTemplate="{StaticResource GameIcon}" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding BuildName}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent2Brush}" Margin="6,0,0,0" ToolTip="New profile zip available"
                                                 Visibility="{Binding HasProfileUpdate, Converter={StaticResource Vis}}" />
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" Margin="6,0,0,0" ToolTip="{Binding Problem}"
                                                 Visibility="{Binding Problem, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,12,0,0" IsEnabled="{Binding ShowLaunch, Converter={x:Static v:Inverse.Instance}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GhostButton}" Click="AddGame_Click" Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Add game" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="ScanGames_Click" Padding="10,9"
                                ToolTip="Find Unreal Engine games in your Steam, Epic and GOG libraries">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Scan" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Main area -->
            <Grid Grid.Column="1">

                <!-- New profile download banner (drawn last so it sits on top) -->
                <Border Panel.ZIndex="10" VerticalAlignment="Top" Margin="40,16,40,0" CornerRadius="12" Padding="16,10"
                        Background="#F0161B26" BorderBrush="{StaticResource Accent2Brush}" BorderThickness="1"
                        Visibility="{Binding BannerText, Converter={StaticResource Vis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent2Brush}" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding BannerText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Review" Padding="16,6" Click="BannerReview_Click" />
                            <Button Style="{StaticResource GhostButton}" Padding="10,6" Margin="6,0,0,0" Click="BannerDismiss_Click" ToolTip="Dismiss">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                            Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
                    <Border Width="88" Height="88" CornerRadius="24" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center">
                        <Canvas Width="54" Height="30">
                            <Rectangle Width="54" Height="30" RadiusX="11" RadiusY="11" Fill="White" />
                            <Ellipse Canvas.Left="9" Canvas.Top="7.5" Width="15" Height="15" Fill="#5B4BD8" />
                            <Ellipse Canvas.Left="30" Canvas.Top="7.5" Width="15" Height="15" Fill="#1FA5C9" />
                        </Canvas>
                    </Border>
                    <TextBlock Text="Build your VR library" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,26,0,8" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" LineHeight="21"
                               Text="Add a game by picking its -Win64-Shipping.exe and the UEVR build it should use, or scan your Steam, Epic and GOG libraries. HeadStart VR then handles your headset, Virtual Desktop and OFXR if you use them, and the injection for you." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Padding="26,12" Click="AddGame_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="White" FontSize="13" Margin="0,0,10,0" />
                                <TextBlock Text="Add your first game" FontSize="14" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="22,12" Margin="10,0,0,0" Click="ScanGames_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0" />
                                <TextBlock Text="Scan my libraries" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Game details -->
                <ScrollViewer DataContext="{Binding Selected}" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding DataContext.ShowDetail, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="250" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Hero -->
                        <Grid ClipToBounds="True">
                            <Border Background="{StaticResource AccentGradient}" Opacity="0.22" />
                            <Image Source="{Binding Icon}" Stretch="UniformToFill" Opacity="0.35" Margin="-60"
                                   Visibility="{Binding Cover, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                <Image.Effect>
                                    <BlurEffect Radius="60" />
                                </Image.Effect>
                            </Image>
                            <Image Source="{Binding Cover}" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0.8" />
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#330B0D12" Offset="0" />
                                        <GradientStop Color="#990B0D12" Offset="0.6" />
                                        <GradientStop Color="#FF0B0D12" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Margin="40,150,40,32">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="104" Height="104" CornerRadius="20" Background="#10131A" BorderBrush="#2A3040" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.7" />
                                    </Border.Effect>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GameIcon}" Margin="8" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="22,0,0,4" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LastPlayedLabel}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,22,0,0">
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Accent2Brush}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding BuildName}" FontSize="12.5" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding LaunchLabel}" FontSize="12.5" />
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding OfxrLabel}" FontSize="12.5" />
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding DelayLabel}" FontSize="12.5" />
                                </Border>
                            </WrapPanel>

                            <Border CornerRadius="10" Background="#2AFF5C7A" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Padding="14,10" Margin="0,8,0,0"
                                    Visibility="{Binding Problem, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Problem}" />
                                    <TextBlock Text=" · click Edit to fix it" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Launch -->
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Height="58" Padding="34,0" Click="Launch_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="White" FontSize="17" Margin="0,0,12,0" />
                                        <TextBlock Text="LAUNCH IN VR" Foreground="White" FontSize="16" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="12,0,0,0" Height="58" Padding="18,0" Click="EditGame_Click" ToolTip="Edit this game">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" Margin="0,0,9,0" />
                                        <TextBlock Text="Edit" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Height="58" Padding="18,0" Click="Shortcut_Click"
                                        ToolTip="Create a desktop shortcut that launches this game in VR">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" Margin="0,0,9,0" />
                                        <TextBlock Text="Shortcut" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerButton}" Margin="10,0,0,0" Height="58" Padding="18,0" Click="RemoveGame_Click" ToolTip="Remove from library">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Profile -->
                            <Border CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20,18" Margin="0,28,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="UEVR PROFILE" Style="{StaticResource SectionHeader}" />
                                            <TextBlock Text="{Binding ProfileLabel}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Game.ProfileZipPath}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="FindOnline_Click" ToolTip="Look for a profile on the Flat2VR Discord, Nexus and the web">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="White" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="Find online…" Foreground="White" />
                                                </StackPanel>
                                            </Button>
                                            <Button Content="From file…" Margin="0,0,8,0" Click="UpdateProfile_Click" ToolTip="Install a profile zip you already downloaded" />
                                            <Button Content="Backups…" Margin="0,0,8,0" Click="Backups_Click" ToolTip="Restore an earlier version of this profile" />
                                            <Button Style="{StaticResource GhostButton}" Click="OpenProfileFolder_Click" ToolTip="Open the profile folder">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- New zip waiting -->
                                    <Border CornerRadius="10" Background="#1A22C7F0" BorderBrush="#5522C7F0" BorderThickness="1" Padding="14,10" Margin="0,14,0,0"
                                            Visibility="{Binding HasProfileUpdate, Converter={StaticResource Vis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent2Brush}" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PendingLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Pending.ZipPath}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                                                <Button Style="{StaticResource PrimaryButton}" Content="Apply" Padding="18,7" Click="ApplyProfile_Click" />
                                                <Button Style="{StaticResource GhostButton}" Content="Ignore" Padding="14,7" Margin="8,0,0,0" Click="IgnoreProfile_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- What happens -->
                            <Border CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="WHAT LAUNCH DOES" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="13" LineHeight="22" TextWrapping="Wrap">
                                        1 · If you use them: starts OFXR (you arm it) and Virtual Desktop Streamer<LineBreak />
                                        2 · Waits until your headset is connected (the same check UEVR does)  ·  3 · Starts the game<LineBreak />
                                        4 · Counts down so the game reaches its menu  ·  5 · Injects this game's UEVR build as administrator<LineBreak />
                                        Once your headset is on, nothing needs a click: if VR doesn't start, it restarts the game and tries once more by itself.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Launch progress -->
                <Grid DataContext="{Binding Session}" Margin="40,30,40,24"
                      Visibility="{Binding DataContext.ShowLaunch, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,26">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="LAUNCHING IN VR" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="{Binding GameName}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border CornerRadius="14" Background="#1E2330" Padding="14,6" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                </Border>
                                <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelCommand}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Back to library" Click="BackToLibrary_Click"
                                        Visibility="{Binding IsRunning, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer x:Name="StepsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,24,0">
                        <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepRow}" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <!-- Prompt -->
                        <Border CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" Padding="22,20"
                                Visibility="{Binding HasPrompt, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" FontSize="13" />
                                    </Border>
                                    <TextBlock Text="{Binding PromptTitle}" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding PromptMessage}" TextWrapping="Wrap" FontSize="13.5" LineHeight="21" Foreground="#C9CEDA" Margin="0,14,0,0" />
                                <ItemsControl ItemsSource="{Binding PromptButtons}" Margin="0,18,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PromptButton}">
                                            <Grid Margin="0,0,0,8">
                                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding Label}" Command="{Binding Command}" Height="46" FontSize="14"
                                                        Visibility="{Binding IsPrimary, Converter={StaticResource Vis}}" />
                                                <Button Style="{StaticResource GhostButton}" Content="{Binding Label}" Command="{Binding Command}" Height="42"
                                                        Visibility="{Binding IsPrimary, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Countdown -->
                        <Border CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22,20" Margin="0,0,0,14"
                                Visibility="{Binding ShowCountdown, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="INJECTING UEVR IN" Style="{StaticResource SectionHeader}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Countdown}" FontFamily="{StaticResource DisplayFont}" FontSize="76" FontWeight="Bold"
                                           HorizontalAlignment="Center" Foreground="{StaticResource AccentGradient}" Margin="0,2,0,0" />
                                <Grid Height="6" Margin="0,4,0,18">
                                    <Border CornerRadius="3" Background="#262C3A" />
                                    <Border CornerRadius="3" Background="{StaticResource AccentGradient}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding CountdownProgress}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Inject now" Height="46" FontSize="14" Command="{Binding InjectNowCommand}" />
                                    <Button Grid.Column="2" Content="+15 s" Height="46" Command="{Binding AddTimeCommand}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Muted}" Text="Or hold Back + Start on your controller for a second." TextWrapping="Wrap"
                                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0" ToolTip="The launcher runs as administrator so UEVR can be injected without a prompt while you wear the headset">
                        <Ellipse x:Name="AdminDot" Style="{StaticResource StatusDot}" />
                        <TextBlock x:Name="AdminText" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                        <Ellipse x:Name="RuntimeDot" Style="{StaticResource StatusDot}" />
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}">
                            <Run Text="OpenXR:" /> <Run Text="{Binding Runtime, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                        <Ellipse x:Name="VdDot" Style="{StaticResource StatusDot}" />
                        <TextBlock x:Name="VdText" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="OfxrDot" Style="{StaticResource StatusDot}" />
                        <TextBlock x:Name="OfxrText" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="v1.0" FontSize="12" Foreground="#5A6072" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
