<Window x:Class="HeadStartVR.Views.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:HeadStartVR.Views"
        Title="Scan for games" Width="860" Height="680" MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <v:VisibleIf x:Key="Vis" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="28,0,0,0">
                <TextBlock Text="Scan for Unreal Engine games" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Cancel_Click" />
            </Grid>

            <TextBlock Grid.Row="1" x:Name="SubText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="28,0,28,14"
                       Text="Searching Steam, Epic and GOG libraries and your extra folders for …-Win64-Shipping.exe…" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,0">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="card" CornerRadius="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="14,10" Margin="8,0,8,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <Image Grid.Column="1" Source="{Binding Icon}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="8,1">
                                                <TextBlock Text="{Binding Store}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ExePath}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding Builds}" SelectedItem="{Binding Build}" VerticalAlignment="Center" ToolTip="UEVR build for this game">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,14">
                <Grid>
                    <TextBlock x:Name="ErrorText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,520,0"
                               Text="Games without a build are added too; pick one later with Edit." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Click="GetBuilds_Click" Margin="0,0,10,0"
                                ToolTip="Download an official UEVR build or a popular fork">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="Get builds…" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddFolderButton" Style="{StaticResource GhostButton}" Click="AddFolder_Click" Margin="0,0,10,0"
                                ToolTip="Search another folder where you keep games (it's remembered in Settings)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="Add folder…" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" />
                        <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Content="Add selected" Margin="10,0,0,0" Padding="24,9" Click="Add_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
