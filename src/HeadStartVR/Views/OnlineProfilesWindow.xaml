<Window x:Class="HeadStartVR.Views.OnlineProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find a profile online" Width="680" Height="540" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="28,0,0,0">
                <TextBlock x:Name="HeaderText" Text="Find a profile online" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,60,0" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,0,28,20">
                    <TextBlock x:Name="ExeText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <!-- Flat2VR -->
                    <Border CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20,16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Flat2VR Discord" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" x:Name="Flat2VrText"
                                           Text="Where the newest profiles are posted, in each game's thread, usually with the UEVR build they need. Opens Discord and copies the game's name so you can paste it into Discord's search." />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Open Discord" VerticalAlignment="Center" Margin="12,0,0,0" Click="Flat2Vr_Click" />
                        </Grid>
                    </Border>

                    <!-- Nexus + web -->
                    <Border CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20,16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Nexus Mods and the web" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Some authors publish on Nexus or their own GitHub. Opens a search in your browser." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="Search Nexus" Click="Nexus_Click" />
                                <Button Content="Search the web" Margin="8,0,0,0" Click="Web_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border CornerRadius="10" Background="#1A22C7F0" BorderBrush="#5522C7F0" BorderThickness="1" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent2Brush}" Margin="0,2,12,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" x:Name="WatchText" TextWrapping="Wrap" LineHeight="20" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,14">
                <Grid>
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,140,0"
                               Text="Profiles are made by community authors. Installing one backs up your current profile first." />
                    <Button Style="{StaticResource PrimaryButton}" Content="Done" HorizontalAlignment="Right" Padding="24,9" Click="Close_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
