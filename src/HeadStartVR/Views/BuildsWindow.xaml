<Window x:Class="HeadStartVR.Views.BuildsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get UEVR builds" Width="900" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="28,0,0,0">
                <TextBlock Text="Get UEVR builds" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
            </Grid>
            <TextBlock Grid.Row="1" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="28,0,28,16"
                       Text="Downloads come straight from each author's own GitHub releases. UEVR is © praydog and its forks belong to their authors; this launcher doesn't bundle or re-host any of them." />

            <Grid Grid.Row="2" Margin="20,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="Sources" Background="Transparent" BorderThickness="0" SelectionChanged="Sources_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="10" Padding="14,11" Margin="8,0,8,8" Background="{StaticResource CardBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A4256" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="bd" Property="Background" Value="#1D2130" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Column="1" CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22,20" Margin="8,0,0,8">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="SourceTitle" FontSize="18" FontWeight="SemiBold" />
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="12,5" Click="OpenPage_Click" ToolTip="Open this source's releases page on GitHub">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0" />
                                    <TextBlock Text="Releases page" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="SourceRepo" Style="{StaticResource Muted}" Margin="0,4,0,0" />

                        <TextBlock Text="VERSION" Style="{StaticResource Label}" Margin="0,20,0,6" />
                        <ComboBox x:Name="Versions" SelectionChanged="Versions_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel x:Name="VariantPanel">
                            <TextBlock Text="VARIANT" Style="{StaticResource Label}" Margin="0,16,0,6" />
                            <ComboBox x:Name="Variants" SelectionChanged="Variants_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="INSTALL INTO" Style="{StaticResource Label}" Margin="0,16,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallBox" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Change…" Margin="8,0,0,0" Click="ChangeFolder_Click" />
                        </Grid>
                        <TextBlock x:Name="TargetText" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Height="46" Margin="0,20,0,0" HorizontalAlignment="Left" Padding="26,0" Click="Install_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,10,0" />
                                <TextBlock x:Name="InstallLabel" Text="Download &amp; install" Foreground="White" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Grid x:Name="ProgressPanel" Height="6" Margin="0,16,0,0" Visibility="Collapsed">
                            <Border CornerRadius="3" Background="#262C3A" />
                            <Border x:Name="ProgressFill" CornerRadius="3" Background="{StaticResource AccentGradient}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,14">
                <Grid>
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,140,0"
                               Text="New builds are set to OpenXR right away and show up in every game's build list." />
                    <Button Style="{StaticResource PrimaryButton}" Content="Done" HorizontalAlignment="Right" Padding="24,9" Click="Close_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
